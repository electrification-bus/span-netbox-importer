@dataclass
class CircuitData:
    """Data for a circuit from MQTT."""

    circuit_id: str
    name: str = ""
    breaker_rating: int = 0
    space: int = 0
    is_duplex: bool = False


@dataclass
class PanelData:
    """Data for a panel from MQTT."""

    serial_number: str
    hostname: str
    vendor_name: str = "SPAN"
    hardware_version: str = ""
    main_breaker_rating: int = 0
    circuits: dict[str, CircuitData] = field(default_factory=dict)
    # Device info from mDNS (populated when --create-devices is used)
    model: str = ""
    firmware_version: str = ""
    eth0_mac: str = ""
    eth1_mac: str = ""
    wlan0_mac: str = ""
    wlan0_ap_mac: str = ""
    ip_addresses: list[str] = field(default_factory=list)


class SpanMqttCollector:
    """Collects panel and circuit data via MQTT."""

    def __init__(
        self,
        serial_number: str,
        hostname: str,
        password: str,
        ca_cert_path: Path,
        timeout: float = 10.0,
        verbose: bool = False,
    ):
        self.serial_number = serial_number
        self.hostname = hostname
        self.password = password
        self.ca_cert_path = ca_cert_path
        self.timeout = timeout
        self.verbose = verbose

        self.panel_data = PanelData(serial_number=serial_number, hostname=hostname)
        self.topic_prefix = f"ebus/5/{serial_number}"
        self._connected = False
        self._data_received = False

    def _log(self, msg: str) -> None:
        """Log message if verbose."""
        if self.verbose:
            print(f"  [MQTT] {msg}", file=sys.stderr)

    def _on_connect(self, client: mqtt.Client, userdata: Any, flags: Any, rc: int, properties: Any = None) -> None:
        """Handle MQTT connection."""
        if rc == 0:
            self._connected = True
            self._log(f"Connected to {self.hostname}")

            # Subscribe to panel topics
            topics = [
                f"{self.topic_prefix}/core/hardware-version",
                f"{self.topic_prefix}/core/breaker-rating",
                f"{self.topic_prefix}/+/name",
                f"{self.topic_prefix}/+/breaker-rating",
                f"{self.topic_prefix}/+/space",
                f"{self.topic_prefix}/+/dipole",
            ]
            for topic in topics:
                client.subscribe(topic)
                self._log(f"Subscribed to {topic}")
        else:
            print(f"  Connection failed with code {rc}", file=sys.stderr)

    def _on_message(self, client: mqtt.Client, userdata: Any, msg: mqtt.MQTTMessage) -> None:
        """Handle MQTT message."""
        topic = msg.topic
        payload = msg.payload.decode("utf-8", errors="replace")

        self._log(f"Received: {topic} = {payload[:50]}...")
        self._data_received = True

        # Parse topic to extract component
        parts = topic.replace(f"{self.topic_prefix}/", "").split("/")

        if len(parts) == 2:
            component, prop = parts

            if component == "core":
                if prop == "hardware-version":
                    self.panel_data.hardware_version = payload
                elif prop == "breaker-rating":
                    try:
                        self.panel_data.main_breaker_rating = int(payload)
                    except ValueError:
                        pass
            else:
                # Circuit data
                circuit_id = component
                if circuit_id not in self.panel_data.circuits:
                    self.panel_data.circuits[circuit_id] = CircuitData(circuit_id=circuit_id)

                circuit = self.panel_data.circuits[circuit_id]
                if prop == "name":
                    circuit.name = payload
                elif prop == "breaker-rating":
                    try:
                        circuit.breaker_rating = int(payload)
                    except ValueError:
                        pass
                elif prop == "space":
                    try:
                        circuit.space = int(payload)
                    except ValueError:
                        pass
                elif prop == "dipole":
                    circuit.is_duplex = payload.lower() in ("true", "1", "yes")

    def collect(self) -> PanelData:
        """Connect to MQTT and collect panel/circuit data."""
        client = mqtt.Client(
            client_id=f"span-netbox-importer-{self.serial_number}",
            callback_api_version=mqtt.CallbackAPIVersion.VERSION2,
        )

        client.username_pw_set(self.serial_number, self.password)
        client.on_connect = self._on_connect
        client.on_message = self._on_message

        # Configure TLS
        client.tls_set(
            ca_certs=str(self.ca_cert_path),
            cert_reqs=ssl.CERT_REQUIRED,
            tls_version=ssl.PROTOCOL_TLS,
        )

        try:
            self._log(f"Connecting to {self.hostname}:8883...")
            client.connect(self.hostname, port=8883, keepalive=60)
            client.loop_start()

            # Wait for data
            start_time = time.time()
            while time.time() - start_time < self.timeout:
                if self._data_received:
                    # Give a bit more time for all messages
                    time.sleep(2)
                    break
                time.sleep(0.1)

            client.loop_stop()
            client.disconnect()

        except Exception as e:
            print(f"  Error connecting to MQTT: {e}", file=sys.stderr)

        return self.panel_data


def query_device_info_mdns(serial_number: str, timeout: float = 3.0) -> dict:
    """
    Query mDNS _device-info service to get MAC addresses and other device info.

    Returns dict with: model, firmware_version, hardware_version, eth0_mac, wlan0_mac,
                       wlan0_ap_mac, addresses
    """
    from zeroconf import Zeroconf, ServiceBrowser, ServiceListener

    result = {
        "model": "",
        "firmware_version": "",
        "hardware_version": "",
        "eth0_mac": "",
        "eth1_mac": "",
        "wlan0_mac": "",
        "wlan0_ap_mac": "",
        "addresses": [],
    }

    class DeviceInfoListener(ServiceListener):
        def __init__(self):
            self.found = False

        def _process_service(self, zc: Zeroconf, type_: str, name: str) -> None:
            """Process a service and extract device info."""
            if serial_number.lower() not in name.lower():
                return

            info = zc.get_service_info(type_, name)
            if not info:
                return

            result["addresses"] = list(info.parsed_addresses())
            if info.properties:
                props = {
                    k.decode() if isinstance(k, bytes) else k:
                    v.decode() if isinstance(v, bytes) else v
                    for k, v in info.properties.items()
                }
                result["model"] = props.get("model", "")
                result["firmware_version"] = props.get("firmware_version", "")
                result["hardware_version"] = props.get("hardware_version", "")
                result["eth0_mac"] = props.get("eth0_mac", "")
                # eth1_mac is "unknown" when not present/used
                eth1 = props.get("eth1_mac", "")
                result["eth1_mac"] = "" if eth1.lower() == "unknown" else eth1
                result["wlan0_mac"] = props.get("wlan0_mac", "")
                result["wlan0_ap_mac"] = props.get("wlan0_ap_mac", "")

                # Only mark as found when we have eth0_mac (indicates full data)
                if result["eth0_mac"]:
                    self.found = True

        def add_service(self, zc: Zeroconf, type_: str, name: str) -> None:
            self._process_service(zc, type_, name)

        def remove_service(self, zc: Zeroconf, type_: str, name: str) -> None:
            pass

        def update_service(self, zc: Zeroconf, type_: str, name: str) -> None:
            # Re-process on update in case properties weren't available initially
            self._process_service(zc, type_, name)

    zeroconf = Zeroconf()
    listener = DeviceInfoListener()
    browser = ServiceBrowser(zeroconf, "_device-info._tcp.local.", listener)

    try:
        start = time.time()
        while time.time() - start < timeout and not listener.found:
            time.sleep(0.1)
    finally:
        browser.cancel()
        zeroconf.close()

    return result


def ensure_manufacturer(nb, name: str = "SPAN", dry_run: bool = False, verbose: bool = False):
    """Ensure manufacturer exists, create if needed."""
    existing = nb.dcim.manufacturers.get(name=name)
    if existing:
        if verbose:
            print(f"  Manufacturer '{name}' already exists", file=sys.stderr)
        return existing

    if dry_run:
        print(f"  Would create manufacturer: {name}")
        return None

    if verbose:
        print(f"  Creating manufacturer: {name}", file=sys.stderr)

    slug = name.lower().replace(" ", "-").replace(".", "")
    return nb.dcim.manufacturers.create(name=name, slug=slug)


