@dataclass
class CircuitData:
    """Data for a circuit from MQTT."""

    circuit_id: str
    name: str = ""
    breaker_rating: int = 0
    spaces: list[int] = field(default_factory=list)
    poles: int = 1
    # Properties received from MQTT, as "node/property"
    received: set[str] = field(default_factory=set)

    REQUIRED = ("info/name", "info/spaces", "breaker/poles")

    @property
    def complete(self) -> bool:
        return all(p in self.received for p in self.REQUIRED)

    @property
    def space(self) -> int:
        """First panel position the circuit occupies (0 if unknown)."""
        return self.spaces[0] if self.spaces else 0

    @property
    def is_duplex(self) -> bool:
        return self.poles >= 2

    @property
    def voltage(self) -> int:
        return 240 if self.is_duplex else 120


@dataclass
class PanelData:
    """Data for a panel from MQTT."""

    serial_number: str
    hostname: str
    vendor_name: str = "SPAN"
    hardware_version: str = ""
    data_model_version: str = ""
    main_breaker_rating: int = 0
    circuits: dict[str, CircuitData] = field(default_factory=dict)
    # Device info from mDNS (populated when --create-devices is used)
    model: str = ""
    firmware_version: str = ""
    eth0_mac: str = ""
    eth1_mac: str = ""
    wlan0_mac: str = ""
    wlan0_ap_mac: str = ""
    ip_addresses: list[str] = field(default_factory=list)


def _int(value: str | None) -> int | None:
    try:
        return int(value)
    except (TypeError, ValueError):
        return None


def read_circuit(device: DiscoveredDevice) -> CircuitData:
    """CircuitData from a discovered circuit device's retained values."""
    circuit = CircuitData(circuit_id=device.device_id)
    for prop in CircuitData.REQUIRED + ("breaker/rating",):
        node, name = prop.split("/")
        if device.get_property(node, name) is not None:
            circuit.received.add(prop)
    circuit.name = device.get_property("info", "name") or ""
    circuit.breaker_rating = _int(device.get_property("breaker", "rating")) or 0
    circuit.poles = _int(device.get_property("breaker", "poles")) or 1
    spaces = [_int(x) for x in (device.get_property("info", "spaces") or "").split(",") if x.strip()]
    circuit.spaces = [x for x in spaces if x is not None]
    return circuit


class SpanTreeCollector:
    """Reads a panel's eBus device tree with ebus-sdk and applies the importer's completeness policy."""

    PANEL_REQUIRED = ("info/data-model-version", "info/hardware-version", "breaker/rating")

    def __init__(
        self,
        serial_number: str,
        hostname: str,
        password: str,
        ca_cert_path: Path,
        timeout: float = 10.0,
        verbose: bool = False,
    ):
        self.serial_number = serial_number
        self.hostname = hostname
        self.password = password
        self.ca_cert_path = ca_cert_path
        self.timeout = timeout
        self.verbose = verbose
        self.device_id = serial_number
        self.devices: dict[str, DiscoveredDevice] = {}
        self.panel_data = PanelData(serial_number=serial_number, hostname=hostname)
        self.error: str | None = None
        self._last_update = 0.0

    def _log(self, msg: str) -> None:
        if self.verbose:
            print(f"  [MQTT] {msg}", file=sys.stderr)

    def mqtt_cfg(self) -> dict:
        return {
            "host": self.hostname,
            "port": 8883,
            "use_tls": True,
            "tls_ca_cert": str(self.ca_cert_path),
            # ebus-mqtt-client defaults to an unverified connection
            "tls_insecure": False,
            "authentication": {"type": "USER_PASS", "username": self.serial_number, "password": self.password},
        }

    @property
    def root(self) -> DiscoveredDevice | None:
        return self.devices.get(self.device_id)

    @property
    def connected(self) -> bool:
        """True once the panel's retained $state has been received."""
        return self.root is not None and self.root.state is not None

    @property
    def ready(self) -> bool:
        """True when the panel's $state is ready; ebus-sdk subscribes to its children only then."""
        return self.root is not None and self.root.state == "ready"

    @property
    def panel_complete(self) -> bool:
        root = self.root
        if root is None or root.description is None:
            return False
        return all(root.get_property(*p.split("/")) is not None for p in self.PANEL_REQUIRED)

    def circuit_devices(self) -> list[DiscoveredDevice]:
        """The panel's described children whose $description type is circuit."""
        root = self.root
        if root is None:
            return []
        children = (self.devices.get(cid) for cid in root.children_ids)
        return [c for c in children if c and c.description and c.description.get("type") == CIRCUIT_DEVICE_TYPE]

    def _complete(self) -> bool:
        """True once the panel, each of its children, and each circuit's required values are present."""
        if not self.panel_complete:
            return False
        if any(
            self.devices.get(cid) is None or self.devices[cid].description is None for cid in self.root.children_ids
        ):
            return False
        return all(read_circuit(c).complete for c in self.circuit_devices())

    def _on_description(self, device: DiscoveredDevice) -> None:
        self._last_update = time.time()

    def _on_property(self, device_id: str, node: str, prop: str, value: str, old: str | None) -> None:
        # Meter values stream continuously; only the nodes read here reset the quiet timer
        if node in READ_NODES:
            self._last_update = time.time()

    def read(self) -> PanelData:
        """Fill panel_data from the current device snapshot."""
        data = PanelData(serial_number=self.serial_number, hostname=self.hostname)
        root = self.root
        if root is not None:
            data.hardware_version = root.get_property("info", "hardware-version") or ""
            data.vendor_name = root.get_property("info", "vendor-name") or data.vendor_name
            data.model = root.get_property("info", "model") or ""
            data.firmware_version = root.get_property("info", "firmware-version") or ""
            data.data_model_version = root.get_property("info", "data-model-version") or ""
            data.main_breaker_rating = _int(root.get_property("breaker", "rating")) or 0
        for device in self.circuit_devices():
            data.circuits[device.device_id] = read_circuit(device)
        self.panel_data = data
        return data

    def collect(self) -> PanelData:
        """Discover the panel's device tree and wait until its values are complete or the timeout passes."""
        # The transport connects asynchronously and retries, so fail fast on a name that cannot resolve
        try:
            socket.getaddrinfo(self.hostname, 8883)
        except OSError as e:
            self.error = f"cannot resolve {self.hostname}: {e}"
            return self.panel_data

        controller = Controller(mqtt_cfg=self.mqtt_cfg(), root_device_id=self.device_id)
        controller.set_on_description_received_callback(self._on_description)
        controller.set_on_property_changed_callback(self._on_property)
        self._log(f"Connecting to {self.hostname}:8883...")
        controller.start_discovery()
        try:
            # Retained values arrive right after each subscribe: wait until the
            # tree is complete, then for a quiet second to let stragglers land.
            start_time = time.time()
            while time.time() - start_time < self.timeout:
                # dict() copies atomically; the network thread mutates the original
                self.devices = dict(controller.devices)
                if self._complete() and time.time() - self._last_update > 1.0:
                    break
                time.sleep(0.1)
            else:
                self.devices = dict(controller.devices)
                if self.connected:
                    print("  Warning: panel tree incomplete at timeout", file=sys.stderr)
            self.read()
        finally:
            controller.stop()
        self._log(f"Devices discovered: {len(self.devices)}")
        return self.panel_data


def query_device_info_mdns(serial_number: str, timeout: float = 3.0) -> dict:
    """
    Query mDNS _device-info service to get MAC addresses and other device info.

    Returns dict with: model, firmware_version, hardware_version, eth0_mac, wlan0_mac,
                       wlan0_ap_mac, addresses
    """
    from zeroconf import ServiceBrowser, ServiceListener, Zeroconf

    result = {
        "model": "",
        "firmware_version": "",
        "hardware_version": "",
        "eth0_mac": "",
        "eth1_mac": "",
        "wlan0_mac": "",
        "wlan0_ap_mac": "",
        "addresses": [],
    }

    class DeviceInfoListener(ServiceListener):
        def __init__(self):
            self.found = False

        def _process_service(self, zc: Zeroconf, type_: str, name: str) -> None:
            """Process a service and extract device info."""
            if serial_number.lower() not in name.lower():
                return

            info = zc.get_service_info(type_, name)
            if not info:
                return

            result["addresses"] = list(info.parsed_addresses())
            if info.properties:
                props = {
                    k.decode() if isinstance(k, bytes) else k: v.decode() if isinstance(v, bytes) else v
                    for k, v in info.properties.items()
                }
                result["model"] = props.get("model", "")
                result["firmware_version"] = props.get("firmware_version", "")
                result["hardware_version"] = props.get("hardware_version", "")
                result["eth0_mac"] = props.get("eth0_mac", "")
                # eth1_mac is "unknown" when not present/used
                eth1 = props.get("eth1_mac", "")
                result["eth1_mac"] = "" if eth1.lower() == "unknown" else eth1
                result["wlan0_mac"] = props.get("wlan0_mac", "")
                result["wlan0_ap_mac"] = props.get("wlan0_ap_mac", "")

                # Only mark as found when we have eth0_mac (indicates full data)
                if result["eth0_mac"]:
                    self.found = True

        def add_service(self, zc: Zeroconf, type_: str, name: str) -> None:
            self._process_service(zc, type_, name)

        def remove_service(self, zc: Zeroconf, type_: str, name: str) -> None:
            pass

        def update_service(self, zc: Zeroconf, type_: str, name: str) -> None:
            # Re-process on update in case properties weren't available initially
            self._process_service(zc, type_, name)

    zeroconf = Zeroconf()
    listener = DeviceInfoListener()
    browser = ServiceBrowser(zeroconf, "_device-info._tcp.local.", listener)

    try:
        start = time.time()
        while time.time() - start < timeout and not listener.found:
            time.sleep(0.1)
    finally:
        browser.cancel()
        zeroconf.close()

    return result


def ensure_manufacturer(nb, name: str = "SPAN", dry_run: bool = False, verbose: bool = False):
    """Ensure manufacturer exists, create if needed."""
    existing = nb.dcim.manufacturers.get(name=name)
    if existing:
        if verbose:
            print(f"  Manufacturer '{name}' already exists", file=sys.stderr)
        return existing

    if dry_run:
        print(f"  Would create manufacturer: {name}")
        return None

    if verbose:
        print(f"  Creating manufacturer: {name}", file=sys.stderr)

    slug = name.lower().replace(" ", "-").replace(".", "")
    return nb.dcim.manufacturers.create(name=name, slug=slug)


def ensure_device_type(nb, manufacturer, model: str = "SPAN Panel", dry_run: bool = False, verbose: bool = False):
    """Ensure device type exists, create if needed."""
    if not manufacturer:
